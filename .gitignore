# --- Secrets ---------------------------------------------------------------
# Never commit these. .env.example is the tracked template and holds no values.
.env
.env.*
!.env.example
config.properties
application-local.properties

# --- Private notes ---------------------------------------------------------
# Anything named *.local.md stays on this machine. Use it for notes that are
# useful to keep next to the code but should not be published - remediation
# steps, account specifics, anything that describes a weakness in this setup.
*.local.md

# --- Broker exports --------------------------------------------------------
# Real holdings, account numbers and position sizes. This repository is public.
# Broker exports are dropped here to be imported and must never be committed;
# the rule exists before the folder does, deliberately.
imports/
*.xlsx
*.xls
aksjelister*.csv
transaksjoner*.csv
beholdning*.csv

# --- Build output ----------------------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/*.jar

# --- Maven wrapper ---------------------------------------------------------
# The wrapper scripts and properties ARE tracked on purpose: they are what lets
# a fresh clone build without Maven installed. Only the downloaded distribution
# is ignored, and that lives in ~/.m2, outside the repository.

# --- Logs ------------------------------------------------------------------
*.log
logs/

# --- Editors and IDEs ------------------------------------------------------
# Note: gitignore has no trailing-comment syntax. A line like
#   Thumbs.db   # Windows
# is the literal pattern "Thumbs.db   # Windows" and matches nothing, which is
# why the entries below each sit on their own line.
*.iml
.idea/
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
