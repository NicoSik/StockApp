# Copy this file to .env and fill in your own values.
# .env is gitignored; this template must never contain a real credential.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
# Connections held open for the HTTP worker threads. 8 is ample for one user.
DB_POOL_SIZE=8

# --- Alpaca -----------------------------------------------------------------
# Keys come from https://app.alpaca.markets/paper/dashboard/overview
API_URL=https://paper-api.alpaca.markets
DATA_URL=https://data.alpaca.markets
API_KEY_ID=your_alpaca_api_key_id
API_SECRET_KEY=your_alpaca_api_secret_key

# Market data feed. "sip" is the full consolidated tape and needs a paid data
# subscription; "iex" is the free single-exchange feed. Leaving this on sip is
# safe either way - the app detects a 403 and falls back to iex automatically.
DATA_FEED=sip

# --- eToro (optional) --------------------------------------------------------
# The one broker here with a real personal API, so its holdings sync live
# instead of needing an export. Leave blank and the feature hides itself.
#
# Generate in eToro: Settings > Trading > API Key Management > Create New Key.
# "Read" permission is enough - this app never places an eToro order. Demo and
# Real are separate environments with separate keys, so a key for one returns
# 403 against the other.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_DEMO=false

# --- Server -----------------------------------------------------------------
SERVER_PORT=9090

# --- Behaviour --------------------------------------------------------------
# Opening cash for the simulated portfolio, applied only when it is first created.
PAPER_STARTING_CASH=100000

# Seconds a quote / chart series is reused before Alpaca is called again.
QUOTE_CACHE_SECONDS=15
CANDLE_CACHE_SECONDS=60

# Refresh the full ~14k asset universe at startup. Off by default: it downloads
# tens of megabytes and delays boot. The daily scheduled job does it instead.
SYNC_ASSETS_ON_START=false
