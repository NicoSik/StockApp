{
    // Shared editor settings only. Anything machine-specific - which JDK to
    // use, in particular - belongs in your own user settings, not here: a path
    // like C:\Program Files\Java\... is wrong on every other machine.
    // The project needs JDK 17+; see README.md > Troubleshooting.
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.debug.settings.onBuildFailureProceed": true,
    "java.format.settings.url": "",
    "files.exclude": {
        "**/target": true
    }
}
